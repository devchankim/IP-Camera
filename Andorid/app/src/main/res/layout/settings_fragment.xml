<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/tv_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="20sp"
        android:textColor="@color/foreground"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="-0.02"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="60dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_input_token"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tv_settings"
        app:helperText="Viewers must enter this token to connect"
        app:helperTextTextColor="@color/muted_foreground"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginTop="32dp"
        style="@style/Widget.Shadcn.TextInput"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_text_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Signaling Token"
            android:inputType="textPassword"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tv_camera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Camera"
        android:textColor="@color/foreground"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginTop="@dimen/spacing_lg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_input_token" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggle_camera_facing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginTop="@dimen/spacing_sm"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:layout_constraintTop_toBottomOf="@id/tv_camera"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_camera_back"
            style="@style/Widget.Shadcn.ToggleButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Rear" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_camera_front"
            style="@style/Widget.Shadcn.ToggleButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Front" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginBottom="40dp"
        android:text="Save"
        android:textSize="14sp"
        app:cornerRadius="@dimen/radius_sm"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
