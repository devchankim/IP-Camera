<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.IpCamera" parent="Theme.Material3.Light.NoActionBar">

        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- shadcn/ui primary = near black -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/foreground</item>
        <item name="colorOnPrimary">@color/primary_foreground</item>

        <!-- Surface -->
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/foreground</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/background</item>

        <!-- Button style -->
        <item name="materialButtonStyle">@style/Widget.Shadcn.Button</item>

        <!-- TextInputLayout -->
        <item name="textInputStyle">@style/Widget.Shadcn.TextInput</item>
    </style>

    <!-- shadcn/ui Primary Button -->
    <style name="Widget.Shadcn.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/primary_foreground</item>
    </style>

    <!-- shadcn/ui Outline Button -->
    <style name="Widget.Shadcn.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="android:textColor">@color/foreground</item>
    </style>

    <!-- shadcn/ui Secondary Button -->
    <style name="Widget.Shadcn.Button.Secondary" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="backgroundTint">@color/secondary</item>
        <item name="android:textColor">@color/secondary_foreground</item>
    </style>

    <!-- shadcn/ui Ghost Button (for overlay on video) -->
    <style name="Widget.Shadcn.Button.Ghost" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="backgroundTint">@color/overlay_dark</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- shadcn/ui TextInput -->
    <style name="Widget.Shadcn.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_sm</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_sm</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_sm</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_sm</item>
        <item name="boxStrokeColor">@color/input</item>
        <item name="boxBackgroundColor">@color/background</item>
        <item name="helperTextTextColor">@color/muted_foreground</item>
    </style>

    <!-- shadcn/ui Toggle Button -->
    <style name="Widget.Shadcn.ToggleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">36dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:textSize">13sp</item>
    </style>

</resources>
