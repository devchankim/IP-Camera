# VideoServer environment configuration template
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Required: secret token that camera app and browser must supply on join
SIGNALING_TOKEN=your_token_here

# Optional: TURN server(s) for NAT traversal
# Format: turn:host:port|username|credential  (comma-separated for multiple)
# TURN_SERVERS=turn:your-turn-server.com:3478|username|credential
